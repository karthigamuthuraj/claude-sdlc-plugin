{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sdlc project profile (.sdlc/project.json)",
  "type": "object",
  "required": [
    "project",
    "tracker",
    "repos",
    "branching"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "slug"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      }
    },
    "requires": {
      "type": "string",
      "description": "sdlc-core version range, e.g. >=0.1 <1"
    },
    "ticketDir": {
      "type": "string",
      "default": ".sdlc/tickets"
    },
    "worktreeDir": {
      "type": "string",
      "default": ".worktrees/{repo}-{name}"
    },
    "tracker": {
      "type": "object",
      "required": [
        "type",
        "site",
        "projectKey",
        "keyPattern"
      ],
      "properties": {
        "type": {
          "enum": [
            "jira"
          ]
        },
        "site": {
          "type": "string"
        },
        "cloudId": {
          "type": "string"
        },
        "projectKey": {
          "type": "string"
        },
        "keyPattern": {
          "type": "string"
        },
        "authEnv": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            },
            "token": {
              "type": "string"
            }
          }
        },
        "statuses": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "transitionsBySkill": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "humanOnlyStatuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commentPrefix": {
          "type": "string"
        },
        "maxAttachmentMb": {
          "type": "number"
        },
        "access": {
          "enum": [
            "connector",
            "token"
          ],
          "default": "connector",
          "description": "connector: all Jira reads and writes go through the connected Atlassian MCP tool (no token needed). token: also allow the jira CLI fallback with the developer's API token (authEnv)."
        }
      }
    },
    "ticketCreation": {
      "type": "object",
      "description": "Settings of the create-ticket skill; every key is optional.",
      "properties": {
        "templateVersion": { "type": "string", "default": "v2", "description": "Folder under templates/jira/; never asked at run time." },
        "mode": { "enum": ["auto", "manual", "ask"], "default": "auto", "description": "auto: predict from the evidence, ask only what it cannot decide, show one preview; manual (ask is the same): ask every decision." },
        "sprint": { "type": "object", "properties": { "mode": { "enum": ["follow", "auto", "ask", "current", "backlog"], "default": "follow" } } },
        "structure": { "enum": ["parent", "single"], "default": "parent", "description": "parent: every ticket is a parent for the general assignee plus one sub-task per developer and one for QA; single: one person gives one ticket." },
        "inference": { "type": "object", "properties": { "qa": { "enum": ["always", "when-asked", "never"], "default": "always" } } },
        "media": { "type": "object", "properties": { "maxFrames": { "type": "number", "default": 12 } } },
        "similar": { "type": "object", "properties": { "maxResults": { "type": "number", "default": 6 } } },
        "description": { "type": "object", "properties": { "elaborate": { "type": "boolean", "default": true } } },
        "subtaskWording": { "type": "object", "additionalProperties": { "type": "object", "properties": { "verb": { "type": "string" }, "description": { "type": "string" } } } },
        "priorities": {
          "type": "object",
          "properties": {
            "default": { "type": "array", "items": { "type": "string" }, "description": "Priority names to offer, in order. Empty or missing: all priorities Jira returns." },
            "bySpace": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "description": "Priority names per Jira space key; overrides default." },
            "hints": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Request hint to priority name, e.g. P1 -> Highest." }
          }
        },
        "generalAssignee": { "description": "Person added to the assignee list when General is ticked: a name, or {name, email}." },
        "qa": { "type": "array", "description": "QA team shared by every application: names, or {name, email}." },
        "applications": {
          "type": "object",
          "description": "The projects (applications) a ticket can belong to, any number, with their teams.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "urlKeywords": { "type": "array", "items": { "type": "string" } },
              "teams": {
                "type": "object",
                "properties": {
                  "backend": { "type": "array" },
                  "frontend": { "type": "array" },
                  "qa": { "type": "array" }
                },
                "description": "People per team: a name, or {name, email}. The same person may appear in several applications or teams."
              }
            }
          }
        }
      }
    },
    "ticketAnalysis": {
      "type": "object",
      "description": "Settings of the analyse-and-plan-ticket skill; every key is optional.",
      "properties": {
        "templateSet": { "type": "string", "default": "standard", "description": "Folder under templates/analysis/ (standard, detailed, or your own)." },
        "files": { "type": "object", "properties": { "analysis": { "type": "string" }, "plan": { "type": "string" } }, "description": "File names; {key} is the ticket key." },
        "outputDir": { "type": "string", "description": "Where the files are written; empty = the ticket folder." },
        "ccGeneralAssignee": { "type": "boolean", "default": true },
        "maxCommentChars": { "type": "number", "default": 28000 },
        "attachFiles": { "type": "boolean", "default": true }
      }
    },
    "ticketImplementation": {
      "type": "object",
      "description": "Settings of the implement-ticket skill; every key is optional.",
      "properties": {
        "plan": {
          "type": "object",
          "properties": {
            "sources": { "type": "array", "items": { "enum": ["comment", "localFile"] }, "default": ["comment", "localFile"] },
            "commentMarkers": { "type": "array", "items": { "type": "string" } },
            "ccPrefix": { "type": "string", "default": "CC:" },
            "checkParent": { "type": "boolean", "default": true },
            "localFile": { "type": "string", "description": "{key} is the ticket key." },
            "ifNoPlan": { "enum": ["stop", "offer-analyse"], "default": "offer-analyse" }
          }
        },
        "status": {
          "type": "object",
          "properties": {
            "transition": { "type": "boolean", "default": true },
            "when": { "enum": ["start", "after-approval", "never"], "default": "start" },
            "from": { "type": "array", "items": { "type": "string" } },
            "to": { "type": "string", "default": "In Progress" }
          }
        },
        "impact": {
          "type": "object",
          "properties": {
            "check": { "type": "boolean", "default": true },
            "depth": { "type": "number", "default": 2 },
            "include": { "type": "array", "items": { "enum": ["callers", "overrides", "interfaceImplementations", "tests", "configuration", "queries"] } },
            "askWhen": { "enum": ["always", "when-impacted"], "default": "always" }
          }
        },
        "approval": { "type": "object", "properties": { "mode": { "enum": ["all-at-once", "per-item"], "default": "all-at-once" } } },
        "implementation": {
          "type": "object",
          "properties": {
            "scope": { "enum": ["ticket", "all"], "default": "ticket" },
            "addTests": { "type": "boolean", "default": true },
            "runVerify": { "type": "boolean", "default": true },
            "verifyCommands": { "type": "array", "items": { "type": "string" } },
            "stopOnNewImpact": { "type": "boolean", "default": true }
          }
        },
        "branch": {
          "type": "object",
          "description": "The feature branch implement-ticket creates.",
          "properties": {
            "mode": { "enum": ["none", "ask", "create"], "default": "create" },
            "base": { "type": "string", "default": "release", "description": "A branch name, \"release\" (latest branch matching releasePattern) or \"current\"." },
            "releasePattern": { "type": "string", "default": "release/*" },
            "releaseOrder": { "enum": ["version", "newest-commit"], "default": "version" },
            "remote": { "type": "string", "default": "origin" },
            "fetch": { "type": "boolean", "default": true },
            "fallbackBase": { "type": "string", "default": "development" },
            "pattern": { "type": "string", "default": "feature/{KEY}", "description": "Placeholders: {KEY}, {key}, {number}, {type}, {slug}." },
            "keyFrom": { "enum": ["ticket", "parent"], "default": "ticket" },
            "typePrefixes": { "type": "object", "description": "Issue type name to {type} value; \"default\" for the rest." },
            "slugMaxWords": { "type": "integer", "default": 6 },
            "ifExists": { "enum": ["ask", "reuse", "stop"], "default": "ask" },
            "dirtyTree": { "enum": ["ask", "carry", "stop"], "default": "ask" },
            "method": { "enum": ["auto", "switch", "worktree"], "default": "auto" },
            "worktreeDir": { "type": "string", "default": ".worktrees" }
          }
        },
        "verify": {
          "type": "object",
          "properties": {
            "planScenarios": { "type": "boolean", "default": true },
            "relatedMethods": { "type": "boolean", "default": true },
            "apiChecks": { "enum": ["documented", "ask", "never"], "default": "documented" }
          }
        },
        "commit": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["ask", "never"], "default": "ask" },
            "subject": { "type": "string", "default": "{KEY}: {summary}" },
            "includeBranch": { "type": "boolean", "default": true },
            "branchLine": { "type": "string", "default": "Branch: {branch}" },
            "coAuthor": { "type": "boolean", "default": true },
            "coAuthorSource": { "enum": ["git"], "default": "git" },
            "extraTrailers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "report": { "type": "object", "properties": { "commentOnFinish": { "enum": ["never", "ask"], "default": "never" } } }
      }
    },
    "gitHost": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "github",
            "gitlab",
            "bitbucket"
          ]
        },
        "org": {
          "type": "string"
        }
      }
    },
    "repos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "stack",
          "parent"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative to the workspace root; \"\" or \".\" when the workspace root is the repo"
          },
          "stack": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "remote": {
            "type": "string"
          },
          "commands": {
            "type": "object",
            "properties": {
              "test": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "formatFile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "typecheck": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "preCommit": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "highRiskPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "foreignPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subprojects": {
            "type": "object",
            "description": "Parts of the same Git repo with another stack (for example frontend/admin as node)",
            "additionalProperties": {
              "type": "object",
              "required": [
                "path",
                "stack"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "stack": {
                  "type": "string"
                },
                "commands": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "branching": {
      "type": "object",
      "required": [
        "pattern",
        "prefixByType",
        "protected"
      ],
      "properties": {
        "pattern": {
          "type": "string"
        },
        "prefixByType": {
          "type": "object"
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slugMaxWords": {
          "type": "integer"
        }
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "roles": {
      "type": "object",
      "properties": {
        "reviewers": {
          "type": "object"
        },
        "qa": {
          "type": "object"
        },
        "techLeads": {
          "type": "array"
        }
      }
    },
    "risk": {
      "type": "object",
      "properties": {
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trackRules": {
      "type": "object"
    },
    "budgets": {
      "type": "object"
    },
    "models": {
      "type": "object"
    },
    "costBudget": {
      "type": "object"
    },
    "protectedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "templateExceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockedCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockedGitSubcommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction": {
      "type": "object"
    },
    "logSources": {
      "type": "object"
    },
    "qaEnvironmentRule": {
      "enum": [
        "merged",
        "deployed",
        "pr-branch"
      ]
    },
    "commitMessagePattern": {
      "type": "string",
      "description": "Regex every commit message must match; default '^<KEY>:'"
    },
    "qaFormat": {
      "enum": [
        "jira",
        "xray",
        "zephyr",
        "spreadsheet"
      ]
    },
    "lifecycle": {
      "type": "object",
      "description": "Custom tracks and lifecycle steps; see CUSTOMIZING.md.",
      "properties": {
        "insert": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "after": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tracks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "steps"
            ]
          }
        },
        "tracks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "base": {
                "enum": [
                  "quick",
                  "standard",
                  "full",
                  "bug",
                  "hotfix"
                ]
              },
              "description": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "insert": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "after": {
                      "type": "string"
                    },
                    "before": {
                      "type": "string"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "tracks": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "steps"
                  ]
                }
              },
              "remove": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "steps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "jiraStatus": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "output": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
