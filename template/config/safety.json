{
  "$comment": "Core safety minimum for every project. Stack packs and project.json add to these lists; they can never remove from them.",
  "protectedFiles": [
    ".env", ".env.*", "*.pem", "*.key", "*.p12", "*.pfx", "*.jks", "*.keystore", "id_rsa*", "id_ed25519*", "id_ecdsa*",
    "credentials", "credentials.json", "*.credentials.json", ".aws/credentials", "*service*account*.json", "*service*key*.json",
    ".npmrc", ".pypirc", ".netrc", ".kube/config", "kubeconfig*", "secrets/**", ".secrets*", "*.secrets.*",
    "secrets.json", "secrets.yaml", "secrets.yml", "*.tfvars", "terraform.tfstate*"
  ],
  "templates": [".env.example", ".env.sample", ".env.template", "*.example", "*.sample"],
  "guardrails": [".claude/**", ".claude-plugin/**", ".git/hooks/**"],
  "protectedBranches": ["main", "master", "develop", "staging", "release/*", "release-*"],
  "blockedGitSubcommands": [
    "merge", "rebase", "reset", "revert", "cherry-pick", "tag", "stash", "clean", "restore", "switch", "checkout",
    "pull", "filter-branch", "filter-repo", "update-ref", "replace", "gc", "prune"
  ],
  "blockedCommands": [
    "\\b(npm|yarn|pnpm)\\s+publish\\b",
    "\\bterraform\\s+(apply|destroy|import)\\b",
    "\\bkubectl\\s+(apply|delete|scale|rollout|edit|patch|replace)\\b",
    "\\bhelm\\s+(install|upgrade|uninstall|rollback)\\b",
    "docker[- ]compose[^|;&]*prod",
    "\\bprod\\.sh\\b",
    "\\brm\\s+-rf\\s+[/~](\\s|$)"
  ],
  "readOnlyBlocked": [
    "\\bdocker\\s+(restart|stop|kill|rm|exec|run|prune|system\\s+prune)",
    "\\bdocker[- ]compose\\s+(up|down|restart|stop|rm|exec|run)",
    "\\bkubectl\\s+(exec|delete|rollout|scale|edit|patch|apply|cp)",
    "\\bsystemctl\\s+(restart|stop|start|reload)",
    "\\bservice\\s+\\S+\\s+(restart|stop|start)"
  ],
  "redaction": {
    "blockPatterns": [
      "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "\\(?\\b\\d{3}\\)?[\\s.-]\\d{3}[\\s.-]\\d{4}\\b",
      "\\+\\d{1,3}[\\s-]?\\d{6,12}\\b",
      "\\b(MRN|DOB|SSN)\\b",
      "[Bb]earer\\s+[A-Za-z0-9._-]{20,}"
    ],
    "allowEmailDomains": ["example.com"]
  }
}
